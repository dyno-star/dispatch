# Copy to .env and fill in. Never commit real secrets.

# API
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me

# Data stores (match docker-compose.yml)
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
REDIS_URL=redis://localhost:6379

# Third-party services (added as each step is built)
MAPS_API_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
SMS_API_KEY=
STORAGE_BUCKET=
